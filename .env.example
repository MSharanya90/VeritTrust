# VeriTrust Environment Configuration
PROJECT_NAME="VeriTrust Security Platform"
ENVIRONMENT="production"

# Database Configuration
DATABASE_URL="sqlite:///./veritrust.db"
# Or PostgreSQL for production:
# DATABASE_URL="postgresql://veritrust_user:veritrust_secure_pass@localhost:5432/veritrust"

# Security & JWT Tokens
SECRET_KEY="enterprise-veritrust-security-shield-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=14

# CORS Settings
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000"

# AI/LLM Provider Settings (Optional external keys)
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""

